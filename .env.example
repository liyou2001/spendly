# Every environment variable the project uses, grouped by where it goes.
# Copy each group into the file named in its heading. Real .env files are git-ignored.
# "Step N" is the plan step that first needs the variable; leave later ones blank until then.

# ---------------------------------------------------------------------------
# Mobile app -> apps/mobile/.env.dev (local Supabase, `npm run mobile`) and
# apps/mobile/.env.prod (hosted, `npm run mobile:prod`)
# EXPO_PUBLIC_* values are bundled into the app and visible to anyone who has it.
# Never put a secret here (Rule 9).
# ---------------------------------------------------------------------------

# Step 4. Leave blank for local Supabase: in development the app uses the computer running
# the dev server (the address your phone loaded the app from), port 54321.
# Hosted: https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# Step 4. Publishable key: PUBLISHABLE_KEY from `npm run db:status` (local, starts with
# sb_publishable_) or the dashboard's API keys page (hosted).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Step 8. Base URL of the payment page, e.g. https://pay.yourapp.com. Leave blank in development:
# links point to the page's dev server (`npm run pay`) on the computer running Expo.
EXPO_PUBLIC_PAY_PAGE_URL=
# Step 10. The one address everyone forwards receipts to, shown in Me → Forward receipts.
# The same as RECEIPTS_EMAIL_ADDRESS below.
EXPO_PUBLIC_RECEIPTS_EMAIL=
# Step 11. Sentry DSN for the app (DSNs are safe to ship).
EXPO_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Local Supabase -> supabase/.env (read by the Supabase CLI)
# Optional: send sign-in codes to real inboxes instead of Mailpit, e.g. for a demo
# (README, "Sign-in codes to real inboxes"). Restart Supabase after changing these.
# ---------------------------------------------------------------------------

SUPABASE_AUTH_EMAIL_SMTP_ENABLED=false
# smtp.gmail.com (with an app password) or smtp.resend.com. Port 465 is set in config.toml.
SMTP_HOST=
# Your Gmail address, or `resend` for Resend.
SMTP_USER=
# Gmail app password, or Resend API key.
SMTP_PASS=
# Who the codes are from: your Gmail address, or an address on your Resend domain.
SMTP_FROM=

# ---------------------------------------------------------------------------
# Payment page -> apps/pay/.env.prod for `npm run pay:prod` (Step 8), or Vercel's environment variables
# Public: VITE_* values are bundled into the page. It needs no key; it only calls Edge
# Functions, which check the link token.
# ---------------------------------------------------------------------------

# Leave blank in development: the page uses local Supabase on the computer serving it.
# Hosted: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# Where "Get the Spendly app" points (App Store or TestFlight). Blank hides the link.
VITE_GET_APP_URL=

# ---------------------------------------------------------------------------
# Edge Functions -> supabase/functions/.env
# Locally, `npx supabase functions serve` reads this file.
# Hosted: `npx supabase secrets set --env-file supabase/functions/.env`.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided to
# functions automatically; don't set them here.
# ---------------------------------------------------------------------------

# Step 8. Payment page base URL, used in payment request links and texts.
PAY_PAGE_URL=
# Step 8. Expo push access token (only if "enhanced push security" is turned on in Expo).
EXPO_ACCESS_TOKEN=

# Step 9. Which model reads receipts: gemini or claude. Blank: Gemini if GEMINI_API_KEY is set,
# otherwise Claude.
RECEIPT_PROVIDER=
# Step 9. Gemini API key from https://aistudio.google.com (has a free tier; on it, Google may use
# what you send to improve its products, so use it with your own receipts only).
GEMINI_API_KEY=
# Step 9. Claude API key for receipt reading.
ANTHROPIC_API_KEY=
# Step 9. Receipt scans allowed per user per month.
RECEIPT_SCANS_PER_MONTH=40

# Step 10. Shared secret the Cloudflare Email Worker sends with each email (X-Inbound-Secret):
# any long random string. Give the Worker the same one with `wrangler secret put INBOUND_SECRET`
# (see apps/email-worker/wrangler.toml).
INBOUND_SECRET=
# Step 10. The one address everyone forwards receipts to, e.g. receipts@in.yourapp.com. It's
# never matched as a sender.
RECEIPTS_EMAIL_ADDRESS=
# Step 10. Sending email (codes for added addresses, the reply to unknown senders):
# resend, mailpit or log. Blank: resend if RESEND_API_KEY is set, mailpit locally, else log.
EMAIL_PROVIDER=
# Step 10. Resend API key (https://resend.com), and who emails are from, e.g.
# Spendly <hello@yourapp.com> (a domain verified in Resend).
RESEND_API_KEY=
EMAIL_FROM=
# Step 10. Mailpit as the functions reach it. Only change it if the local stack's differs.
MAILPIT_URL=http://inbucket:8025

# Step 11. Shared secret pg_cron sends to send-reminders: any long random string. The database
# gets the same one as the Vault secret cron_secret (README, "Reminders and texts").
CRON_SECRET=
# Step 11. Which provider sendText() uses: log (development, writes to outbound_messages only), twilio or telnyx.
SMS_PROVIDER=log
# Step 11. The exact URL of sms-inbound as configured in Twilio, which its signatures cover:
# https://<project-ref>.supabase.co/functions/v1/sms-inbound
SMS_WEBHOOK_URL=
# Step 11. Twilio, if SMS_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Step 11. Telnyx, if SMS_PROVIDER=telnyx. The public key verifies STOP webhooks.
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_PUBLIC_KEY=
# Step 11. Sentry DSN for Edge Functions.
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Tooling -> your shell or CI, not a file the app reads
# ---------------------------------------------------------------------------

# Lets `npx supabase` run without `supabase login` (CI). Create at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# The hosted project's ref, from the dashboard URL.
SUPABASE_PROJECT_REF=
# Hosted database password, used by `supabase link` and `supabase db push`.
SUPABASE_DB_PASSWORD=
# Step 11. Uploads source maps to Sentry during EAS builds (set as an EAS secret).
SENTRY_AUTH_TOKEN=
