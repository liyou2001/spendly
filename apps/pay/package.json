{
  "name": "pay",
  "version": "1.0.0",
  "private": true,
  "description": "The payment page people without the app open from a private link.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:prod": "vite --host --mode prod",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@spendly/ledger": "*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
