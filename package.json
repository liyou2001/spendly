{
  "name": "spendly",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "mobile": "npm run start --workspace mobile --",
    "mobile:prod": "npm run start:prod --workspace mobile --",
    "pay": "npm run dev --workspace pay",
    "pay:prod": "npm run dev:prod --workspace pay",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/db/src/database.types.ts && prettier --write packages/db/src/database.types.ts",
    "test:functions": "scripts/test-functions.sh",
    "receipts:accuracy": "deno run --no-lock --env-file=supabase/functions/.env --allow-read --allow-net --allow-env scripts/receipt-accuracy.ts",
    "email:test": "deno run --no-lock --env-file=supabase/functions/.env --allow-read --allow-net --allow-env scripts/send-test-email.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
